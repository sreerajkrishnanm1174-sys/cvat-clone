# Copy to .env. Do not commit .env.

# CVAT reachable from this service. Inside the CVAT docker network this is the server alias.
CVAT_BASE_URL=http://cvat-server:8080

# Personal access token used only by the webhook worker and the scheduled sync.
# Create it in CVAT: profile -> API tokens. Leave empty to disable background sync.
CVAT_ACCESS_TOKEN=
CVAT_AUTH_SCHEME=Bearer

# Shared secret CVAT sends as X-Signature-256. Use the same value when the webhook is registered.
WEBHOOK_SECRET=change-me

# External vision calls stay off until a project turns this on.
ANTHROPIC_API_KEY=
ANALYZER_ALLOW_EXTERNAL_DEFAULT=false

# Nuclio gateway reachable from this service. Not the dashboard port.
NUCLIO_INVOKE_URL=http://nuclio:8080
YOLO_FUNCTION_NAME=onnx-wongkinyiu-yolov7

DATABASE_URL=postgresql+psycopg://analyzer:analyzer@analyzer_db:5432/analyzer
REDIS_URL=redis://analyzer_redis:6379/0
ANALYZER_DATA_DIR=/data

# Public path the CVAT UI calls. Traefik strips this prefix.
ANALYZER_ROOT_PATH=
